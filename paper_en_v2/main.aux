\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Sim-to-real transfer results on ORAD-3D (\%). Both AgriOcc models use the complete ORAD-3D training set and only the center forward-facing camera. The transfer model is initialized with weights pretrained on AgriOcc-Dataset and adapted for 2 epochs. \texttt  {Test (w/o Free)} denotes mIoU excluding Free, following the ORAD-3D paper; \texttt  {Test} denotes mIoU over all nine classes; and \texttt  {Test\_farm} denotes mIoU over the classes present in the farmland subset. The OpenOcc, OccFormer, and SurroundOcc results are taken from the ORAD-3D paper.}}{13}{table.4}\protected@file@percent }
\newlabel{tab:orad}{{4}{13}{Sim-to-real transfer results on ORAD-3D (\%). Both AgriOcc models use the complete ORAD-3D training set and only the center forward-facing camera. The transfer model is initialized with weights pretrained on AgriOcc-Dataset and adapted for 2 epochs. \texttt {Test (w/o Free)} denotes mIoU excluding Free, following the ORAD-3D paper; \texttt {Test} denotes mIoU over all nine classes; and \texttt {Test\_farm} denotes mIoU over the classes present in the farmland subset. The OpenOcc, OccFormer, and SurroundOcc results are taken from the ORAD-3D paper}{table.4}{}}
