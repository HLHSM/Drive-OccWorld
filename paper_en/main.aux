\citation{li2022bevformer}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Overall AgriOcc architecture. Three forward-facing images are processed by ResNet--FPN to produce four-scale features. The six-layer GeoVis-BEV encoder executes GVAD, image spatial cross-attention, and feed-forward updates in sequence in each layer. NearFar applies its near--far query layout in the first five layers and restores dense BEV before the sixth layer. The three-layer occupancy decoder provides multi-level supervision; its final layer uses Agri-AMoE to lift BEV tokens into a 3D feature volume and outputs $100\times 100\times 25\times 6$ semantic logits.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:overview}{{4}{6}{Overall AgriOcc architecture. Three forward-facing images are processed by ResNet--FPN to produce four-scale features. The six-layer GeoVis-BEV encoder executes GVAD, image spatial cross-attention, and feed-forward updates in sequence in each layer. NearFar applies its near--far query layout in the first five layers and restores dense BEV before the sixth layer. The three-layer occupancy decoder provides multi-level supervision; its final layer uses Agri-AMoE to lift BEV tokens into a 3D feature volume and outputs $100\times 100\times 25\times 6$ semantic logits}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}GeoVis-BEV encoder}{6}{subsection.3.4}\protected@file@percent }
\newlabel{sec:bev-encoder}{{3.4}{6}{GeoVis-BEV encoder}{subsection.3.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.1}Geometry-Visible Anchor Deformable Attention}{6}{subsubsection.3.4.1}\protected@file@percent }
\newlabel{sec:gvad}{{3.4.1}{6}{Geometry-Visible Anchor Deformable Attention}{subsubsection.3.4.1}{}}
\citation{li2022bevformer}
\citation{zhu2021deformable}
\citation{wang2022detr3d}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Overall architecture of the GeoVis-BEV encoder. Three forward-facing images are processed by ResNet--FPN and fed to a six-layer encoder. GVAD updates BEV tokens in every layer. NearFar retains dense near-field queries and regularly sparsely samples far-field queries in the first five layers; after restoration to a dense grid, the final layer performs image-conditioned refinement.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:geovis-bev-encoder}{{5}{7}{Overall architecture of the GeoVis-BEV encoder. Three forward-facing images are processed by ResNet--FPN and fed to a six-layer encoder. GVAD updates BEV tokens in every layer. NearFar retains dense near-field queries and regularly sparsely samples far-field queries in the first five layers; after restoration to a dense grid, the final layer performs image-conditioned refinement}{figure.5}{}}
\@writefile{toc}{\contentsline {paragraph}{Local deformable branch.}{7}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Geometry-visible anchor branch.}{7}{section*.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Visibility-gated fusion.}{8}{section*.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.2}NearFar BEV query layout}{8}{subsubsection.3.4.2}\protected@file@percent }
\newlabel{sec:nearfar}{{3.4.2}{8}{NearFar BEV query layout}{subsubsection.3.4.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Agricultural Structure-Adaptive Mixture-of-Experts 3D occupancy decoder}{8}{subsection.3.5}\protected@file@percent }
\newlabel{sec:agri-amoe}{{3.5}{8}{Agricultural Structure-Adaptive Mixture-of-Experts 3D occupancy decoder}{subsection.3.5}{}}
\citation{shi2026oneocc}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces GVAD architecture. The camera-projection mask is first reduced to visibility for each BEV token. The local deformable branch predicts sampling locations and weights from queries to form local BEV updates. The geometry-visible anchor branch divides the BEV plane into $4\times 8$ tiles, constructs 32 anchors weighted by feature confidence and visibility, and forms anchor context through distance-biased multi-head attention. The two branches are fused through visibility gating and residual connections into enhanced BEV tokens.}}{9}{figure.6}\protected@file@percent }
\newlabel{fig:gvad}{{6}{9}{GVAD architecture. The camera-projection mask is first reduced to visibility for each BEV token. The local deformable branch predicts sampling locations and weights from queries to form local BEV updates. The geometry-visible anchor branch divides the BEV plane into $4\times 8$ tiles, constructs 32 anchors weighted by feature confidence and visibility, and forms anchor context through distance-biased multi-head attention. The two branches are fused through visibility gating and residual connections into enhanced BEV tokens}{figure.6}{}}
\citation{wei2023surroundocc,wang2023openoccupancy}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Agri-AMoE 3D occupancy decoder. 2D BEV tokens are lifted into a 3D volume and enhanced by channel attention. Enhanced features are passed in parallel to three anisotropic experts and used to compute spatial saliency and three-direction gradient energy for per-voxel routing weights. The weighted expert outputs are summed, residually fused, and classified.}}{10}{figure.7}\protected@file@percent }
\newlabel{fig:agri-amoe}{{7}{10}{Agri-AMoE 3D occupancy decoder. 2D BEV tokens are lifted into a 3D volume and enhanced by channel attention. Enhanced features are passed in parallel to three anisotropic experts and used to compute spatial saliency and three-direction gradient energy for per-voxel routing weights. The weighted expert outputs are summed, residually fused, and classified}{figure.7}{}}
