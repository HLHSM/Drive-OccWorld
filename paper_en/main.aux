\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Sim-to-real transfer results on ORAD-3D (\%). Both AgriOcc variants use the full ORAD-3D training set and only the center forward camera. The transfer model is initialized by AgriOcc-Dataset pretraining and adapted for two epochs. \texttt  {Test (w/o Free)} excludes Free; \texttt  {Test} is nine-class mIoU; \texttt  {Test\_farm} is mIoU over classes in the farmland subset. Baseline results are from the ORAD-3D paper.}}{13}{table.3}\protected@file@percent }
\newlabel{tab:orad}{{3}{13}{Sim-to-real transfer results on ORAD-3D (\%). Both AgriOcc variants use the full ORAD-3D training set and only the center forward camera. The transfer model is initialized by AgriOcc-Dataset pretraining and adapted for two epochs. \texttt {Test (w/o Free)} excludes Free; \texttt {Test} is nine-class mIoU; \texttt {Test\_farm} is mIoU over classes in the farmland subset. Baseline results are from the ORAD-3D paper}{table.3}{}}
