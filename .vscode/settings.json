{
  "latex-workshop.latex.autoBuild.run": "onFileChange",
  "latex-workshop.latex.recipe.default": "lastUsed",
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-xelatex-texlive2026",
      "command": "/data/HL/texlive/2026/bin/x86_64-linux/latexmk",
      "args": [
        "-xelatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-halt-on-error",
        "%DOC%"
      ],
      "env": {
        "PATH": "/data/HL/texlive/2026/bin/x86_64-linux:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "TEXMFCONFIG": "/data/HL/texlive/2026/texmf-config",
        "TEXMFVAR": "/data/HL/texlive/2026/texmf-var"
      }
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "XeLaTeX (TeX Live 2026)",
      "tools": [
        "latexmk-xelatex-texlive2026"
      ]
    }
  ]
}
