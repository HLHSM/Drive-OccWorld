{
  "latex-workshop.latex.autoBuild.run": "onFileChange",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.kpsewhich.path": "/data/HL/texlive/2026/bin/x86_64-linux/kpsewhich",
  "latex-workshop.latex.clean.command": "/data/HL/texlive/2026/bin/x86_64-linux/latexmk",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-xelatex",
      "command": "/data/HL/texlive/2026/bin/x86_64-linux/latexmk",
      "env": {
        "PATH": "/data/HL/texlive/2026/bin/x86_64-linux:/usr/local/bin:/usr/bin:/bin"
      },
      "args": [
        "-xelatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-halt-on-error",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "XeLaTeX (Local TeX Live)",
      "tools": [
        "latexmk-xelatex"
      ]
    }
  ],
  "chat.tools.terminal.autoApprove": {
    "/^git status --short && printf '\\\\nLaTeX tools:\\\\n' && command -v latexmk \\|\\| true && command -v pdflatex \\|\\| true && command -v xelatex \\|\\| true && command -v bibtex \\|\\| true$/": {
      "approve": true,
      "matchCommandLine": true
    }
  }
}
