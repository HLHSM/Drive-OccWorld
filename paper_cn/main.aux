\newlabel{sec:nearfar}{{3.4.2}{10}{近远场 BEV 查询布局}{subsubsection.3.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces GVAD 架构。相机投影掩码首先归约为每个 BEV token 的可见性；局部可变形分支根据查询预测采样位置和权重，形成局部 BEV 更新；几何可见锚点分支将 BEV 平面划分为 $4\times 8$ 个 tile，以特征置信度和可见性加权构建 32 个锚点，并通过距离偏置的多头注意力形成锚点上下文。两条分支经可见性门控和残差连接融合为增强 BEV token。}}{11}{figure.4}\protected@file@percent }
\newlabel{fig:gvad}{{4}{11}{GVAD 架构。相机投影掩码首先归约为每个 BEV token 的可见性；局部可变形分支根据查询预测采样位置和权重，形成局部 BEV 更新；几何可见锚点分支将 BEV 平面划分为 $4\times 8$ 个 tile，以特征置信度和可见性加权构建 32 个锚点，并通过距离偏置的多头注意力形成锚点上下文。两条分支经可见性门控和残差连接融合为增强 BEV token。}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}农业结构自适应混合专家三维占用解码器}{11}{subsection.3.5}\protected@file@percent }
\newlabel{sec:agri-amoe}{{3.5}{11}{农业结构自适应混合专家三维占用解码器}{subsection.3.5}{}}
\citation{shi2026oneocc}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces NearFar 架构。输入稠密 BEV 网格沿前向距离划分为近场与远场，远场按步长 2 下采样激活。 所有 active token 保留其原始稠密网格坐标，并在前五层进行稀疏编码； 随后，未激活远场位置由相邻四个 active token 的双线性权重恢复为完整网格。}}{12}{figure.5}\protected@file@percent }
\newlabel{fig:nearfar}{{5}{12}{NearFar 架构。输入稠密 BEV 网格沿前向距离划分为近场与远场，远场按步长 2 下采样激活。 所有 active token 保留其原始稠密网格坐标，并在前五层进行稀疏编码； 随后，未激活远场位置由相邻四个 active token 的双线性权重恢复为完整网格。}{figure.5}{}}
