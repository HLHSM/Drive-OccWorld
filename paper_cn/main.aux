\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Agri-AMoE 三维占用解码器。最终 BEV token 被提升为三维特征体；通道显著性、空间显著性与 $x/y/z$ 方向梯度能量输入逐体素路由器，分别激活平面局部细节、垂直结构和大范围平面上下文专家。三个专家的加权结果经残差混合与 $1\times 1\times 1$ 分类卷积产生语义体素 logits。}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:agri-amoe}{{3}{9}{Agri-AMoE 三维占用解码器。最终 BEV token 被提升为三维特征体；通道显著性、空间显著性与 $x/y/z$ 方向梯度能量输入逐体素路由器，分别激活平面局部细节、垂直结构和大范围平面上下文专家。三个专家的加权结果经残差混合与 $1\times 1\times 1$ 分类卷积产生语义体素 logits。}{figure.3}{}}
