\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces AgriOcc 总体结构。三路前视图像经 ResNet--FPN 提取多尺度特征；GVAD 增强的 BEV 编码器将多相机证据聚合至前方鸟瞰空间；近远场布局优先分配近场计算；三层占用解码器输出 $100\times 100\times 25\times 6$ 语义 logits。ADHR 仅在训练阶段对困难体素施加辅助监督。}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:overview}{{1}{6}{AgriOcc 总体结构。三路前视图像经 ResNet--FPN 提取多尺度特征；GVAD 增强的 BEV 编码器将多相机证据聚合至前方鸟瞰空间；近远场布局优先分配近场计算；三层占用解码器输出 $100\times 100\times 25\times 6$ 语义 logits。ADHR 仅在训练阶段对困难体素施加辅助监督。}{figure.1}{}}
