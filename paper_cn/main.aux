\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces GeoVis-BEV 编码器整体架构。三路前视图像经 ResNet--FPN 提取多尺度特征后输入六层编码器； GVAD 在各编码层中更新 BEV token，NearFar 在前五层保留近场稠密查询并对远场规则稀疏采样， 恢复为稠密网格后由最后一层完成图像条件细化。}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:geovis-bev-encoder}{{5}{6}{GeoVis-BEV 编码器整体架构。三路前视图像经 ResNet--FPN 提取多尺度特征后输入六层编码器； GVAD 在各编码层中更新 BEV token，NearFar 在前五层保留近场稠密查询并对远场规则稀疏采样， 恢复为稠密网格后由最后一层完成图像条件细化。}{figure.5}{}}
