\@writefile{toc}{\contentsline {paragraph}{局部可变形分支。}{6}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{几何可见锚点分支。}{6}{section*.5}\protected@file@percent }
